# =============================================================================
# SaaS Starter Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# API Configuration
# =============================================================================
# The base URL for your backend API (without trailing slash)
#
# Development (local):
#   VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# Production (with nginx/traefik proxy):
#   VITE_API_BASE_URL=/api/v1  (relative path - proxy handles routing)
#
# Production (separate API domain):
#   VITE_API_BASE_URL=https://api.yourcompany.com/api/v1
#
VITE_API_BASE_URL=http://localhost:8080/api/v1

# =============================================================================
# Application Branding (Optional)
# =============================================================================
# Application name displayed in the UI
VITE_APP_NAME=SaaS Starter

# Company/Organization name
VITE_COMPANY_NAME=Your Company Ltd

# =============================================================================
# Analytics & Monitoring (Optional)
# =============================================================================
# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# Build Configuration
# =============================================================================
# Build timestamp (set automatically)
# VITE_BUILD_TIME=

# Git commit hash (set automatically)
# VITE_GIT_HASH=

# Application version
VITE_APP_VERSION=1.0.0
