# ============================================
# Microfinance System Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ===== Database Configuration =====
# Separate env vars (recommended for production)
DB_HOST=localhost
DB_PORT=5432
DB_USER=microfinance
DB_PASSWORD=change-this-password
DB_NAME=microfinance
DB_SSLMODE=disable

# Legacy support (if DB_PASSWORD is empty, falls back to DATABASE_URL)
# DATABASE_URL=postgres://microfinance:password@localhost:5432/microfinance?sslmode=disable

# Test database
DATABASE_URL_TEST=postgres://microfinance:password@localhost:5432/microfinance_test?sslmode=disable

# ===== Server Configuration =====
PORT=8080
HOST=localhost
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
ENV=development

# ===== Security Keys =====
# IMPORTANT: Generate new keys with: openssl rand -base64 32
JWT_SECRET=your-secret-jwt-key-change-this-in-production
SECRET_KEY=your-32-character-encryption-key

# ===== Storage Configuration =====
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# AWS S3 Configuration (for production)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=microfinance-documents
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_S3_ENDPOINT=https://s3.custom-domain.com

# ===== PostgreSQL Backup Configuration =====
PGBACKUP_ENABLED=false
# PGBACKUP_S3_BUCKET=microfinance-db-backups
# PGBACKUP_S3_PREFIX=wal-archives/
# PGBACKUP_LOG_FILE=/var/log/postgresql/wal-archive.log
# BACKUP_RETENTION_DAYS=7

# ===== ClamAV Configuration (Virus Scanning) =====
CLAMAV_ENABLED=false
CLAMAV_ADDR=tcp://clamav:3310
# CLAMAV_REQUIRED=true

# ===== Logging Configuration =====
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json or console
LOG_SAMPLING=true  # Enable sampling to reduce log volume

# ===== Audit Worker Configuration =====
AUDIT_WORKER_ENABLED=true
AUDIT_WORKER_POLL_INTERVAL=5  # seconds
AUDIT_WORKER_BATCH_SIZE=500

# ===== Audit Archive Configuration (S3 WORM) =====
AUDIT_ARCHIVE_ENABLED=false
AUDIT_S3_BUCKET=microfinance-audit-archive
AUDIT_ARCHIVE_CRON=0 0 * * *  # Daily at midnight UTC

# ===== Grafana Configuration =====
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# ===== Redis Configuration =====
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== CORS Configuration =====
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ===== Runtime Environment =====
RUNTIME_ENV=development  # development or production
ENABLE_FILE_UPLOAD=false

# ===== Email/SMTP Configuration =====
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=noreply@microfinance.com
SMTP_FROM_NAME=Microfinance

# For Gmail: Use App Password (not your regular password)
# Enable 2FA, then create App Password at: https://myaccount.google.com/apppasswords
# For other providers (SendGrid, Mailgun, etc.), use their SMTP credentials

# ===== Company Information =====
# COMPANY_NAME=Your Company Ltd.
# COMPANY_ADDR1=123 Main Street
# COMPANY_ADDR2=Dar es Salaam, Tanzania
# COMPANY_PHONE=+255 700 000 000
# COMPANY_EMAIL=info@company.com
# COMPANY_LOGO_URL=/static/logo.png
# CURRENCY=TZS

# ===== TLS Configuration (Production) =====
# RUNTIME_ENV=production
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# ===== Testing =====
# TEST_RECOVERY_PORT=5433
# BACKUP_DIR=/tmp/pg_backups

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================
# NOTE: DB_HOST/PORT/USER/NAME/PASSWORD are already set above for local dev.
# When running inside Docker Compose the app container reads the same vars —
# just ensure DB_HOST matches the service name in docker-compose.yml (db).
# Override DB_HOST=db in your shell / CI environment, not here.

# ===== Service Ports =====
API_PORT=8080
GRAFANA_PORT=3000
CLAMAV_PORT=3310

# ===== Domain Configuration (Production) =====
DOMAIN=microfinance.example.com
ACME_EMAIL=admin@example.com

# ===== Version =====
VERSION=latest

# =============================================================================
# DEPLOYMENT QUICK REFERENCE
# =============================================================================
#
# Development (Backend + DB + Redis):
#   docker-compose up -d
#   API: http://localhost:8080
#
# With Grafana dashboards:
#   docker-compose --profile observability up -d
#   Grafana: http://localhost:3000
#
# With ClamAV virus scanning:
#   docker-compose --profile security up -d
#
# Production with SSL (Traefik + Let's Encrypt):
#   docker-compose --profile production up -d
#   Access: https://your-domain.com
#
# Build images:
#   docker-compose build
#
# Stop services:
#   docker-compose down
#
# Stop and remove volumes:
#   docker-compose down -v
