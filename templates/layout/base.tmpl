{{define "base"}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{block "title" .}}Salary Slip{{end}}</title>
  <style>
    /* ----- Print Setup (A4) ----- */
    @page {
      size: A4;
      margin: 18mm 16mm 18mm 16mm;
    }
    html, body { height: 100%; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "Noto Sans", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
      color: #111827;
      line-height: 1.35;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      position: relative;
    }

    /* --- Common Header/Footer (fixed for print) --- */
    .page-header, .page-footer {
      position: fixed;
      left: 0; right: 0;
      color: #374151;
    }
    .page-header {
      top: 0;
      height: 40mm;
      padding: 10mm 16mm 0 16mm;
      box-sizing: border-box;
    }
    .page-footer {
      bottom: 0;
      height: 18mm;
      padding: 2mm 16mm 4mm 16mm;
      box-sizing: border-box;
      font-size: 10px;
      color: #6B7280;
      border-top: 1px solid #E5E7EB;
    }
    /* Content area leaves space for header/footer */
    .page-content {
      margin-top: 36mm;
      margin-bottom: 22mm;
    }

    /* Header styles */
    .brand-row {
      display: flex; align-items: center; gap: 12px;
    }
    .brand-logo {
      width: 28mm; height: 28mm; object-fit: contain;
    }
    .brand-name {
      font-size: 20px; font-weight: 700; letter-spacing: 0.3px;
    }
    .brand-address {
      font-size: 11px; color: #4B5563;
    }

    /* Title banner */
    .title-banner {
      text-align: center; padding: 8px 12px; margin: 6px 0 10px 0;
      border: 1px solid #C9D4E5; background: #E6F0FF; color: #1F2937;
      font-weight: 700; font-size: 16px;
    }
    .subtitle { text-align:center; color: #3B82F6; margin-bottom: 6px; }

    /* Tables */
    table { border-collapse: collapse; width: 100%; }
    .grid { width: 100%; border: 1px solid #C9D4E5; }
    .grid th { background: #2F6BFF; color: white; text-align: left; padding: 6px 8px; font-size: 12px; }
    .grid td { padding: 6px 8px; border-top: 1px solid #E5E7EB; font-size: 12px; }
    .grid tfoot td { background: #E6F0FF; font-weight: 700; }
    .label { width: 28%; background: #F9FAFB; font-weight:600; color:#374151; }
    .val { width: 22%; background: white; }

    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    .netbox {
      border: 1px solid #2F6BFF;
      margin-top: 12px;
    }
    .netbox .head { background:#2F6BFF; color:#fff; padding:8px 10px; font-weight:700; }
    .netbox .row  { display:flex; }
    .netbox .row div { flex:1; padding:8px 10px; border-top:1px solid #E5E7EB; }
    .netbox .row div:first-child { font-weight:600; }

    .sign-row { display:grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 18px; font-size: 12px; }
    .muted { color:#6B7280; }

    /* Watermark */
    .watermark {
      position: fixed;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.06;
      z-index: -1;
      pointer-events: none;
      text-align: center;
    }
    .watermark img { width: 70mm; height:auto; }

    /* Screen tweaks */
    @media screen {
      body { background: #f3f4f6; }
      .page-sheet {
        width: 210mm; min-height: 297mm; margin: 10mm auto; background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        padding: 0;
      }
      .page-header, .page-footer { position: sticky; }
      .page-header { top: 0; background: white; }
      .page-footer { bottom: 0; background: white; }
      .page-content { padding: 0 16mm; }
    }
  </style>
  {{block "extra_head" .}}{{end}}
</head>
<body>
  <div class="page-sheet">
    <!-- Watermark -->
    <div class="watermark">
      <img src="{{.LogoURL}}" alt="Watermark">
    </div>

    <!-- Common Header -->
    <header class="page-header">
      {{template "header" .}}
    </header>

    <!-- Page Content -->
    <main class="page-content">
      {{block "content" .}}{{end}}
    </main>

    <!-- Common Footer -->
    <footer class="page-footer">
      {{template "footer" .}}
    </footer>
  </div>
</body>
</html>
{{end}}